      "description": "Labelled light field with visible control border, blue focus and written error support.",
      "html": "<label class=\"ds-field-label\" for=\"ds-email\">Email</label><input class=\"ds-field\" id=\"ds-email\" type=\"email\" placeholder=\"you@company.com\">",
      "css": ".ds-field-label{display:block;font:500 .9375rem var(--font-sans);color:var(--color-fg);margin-bottom:.625rem}.ds-field{width:calc(100% - 2rem);border:1px solid var(--color-control);border-radius:var(--radius-md);background:color-mix(in srgb,var(--color-elevated) 60%,transparent);color:var(--color-fg);padding:.75rem 1rem;font:1.0625rem/1.6 var(--font-sans);caret-color:var(--color-accent);transition:border-color 150ms var(--ease-precise),background-color 150ms var(--ease-precise),box-shadow 150ms var(--ease-precise)}.ds-field::placeholder{color:var(--color-subtle)}.ds-field:hover{border-color:var(--color-line-strong)}.ds-field:focus,.ds-field:focus-visible{outline:none;border-color:var(--color-accent);background:var(--color-elevated);box-shadow:0 0 0 2px color-mix(in srgb,var(--color-accent) 25%,transparent)}.ds-field[aria-invalid=\"true\"]{border-color:var(--color-danger)}.ds-field:disabled{opacity:.5}"
    },
    {
      "name": "Taxonomy Text",
      "kind": "custom",
      "refersTo": "tag",
      "description": "Non-interactive plain taxonomy text.",
      "html": "<span class=\"ds-tag\">TypeScript</span>",
      "css": ".ds-tag{display:inline-flex;color:var(--color-muted);font:.9375rem/1.4 var(--font-sans)}"
    },
    {
      "name": "Primary Navigation",
      "kind": "nav",
      "description": "Compact links with an electric-blue active hairline.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Primary\"><a href=\"#about\">About</a><a href=\"#services\" aria-current=\"page\">Services</a><a href=\"#work\">Work</a></nav>",
      "css": ".ds-nav{display:flex;gap:.25rem}.ds-nav a{position:relative;display:flex;align-items:center;height:2.75rem;padding:0 .875rem;border-radius:var(--radius-sm);font:.9375rem var(--font-sans);color:var(--color-muted);text-decoration:none;transition:color 150ms var(--ease-precise)}.ds-nav a:hover,.ds-nav a[aria-current]{color:var(--color-fg)}.ds-nav a[aria-current]::after{content:\"\";position:absolute;left:.875rem;right:.875rem;bottom:-1px;height:1px;background:var(--color-accent)}.ds-nav a:focus-visible{outline:2px solid var(--color-accent);outline-offset:3px}"
    },
    {
      "name": "Technology Row",
      "kind": "custom",
      "refersTo": "technology-row",
      "description": "A layer, explanation and tool list in an open definition row.",
      "html": "<dl class=\"ds-tools\"><div><dt>Backend</dt><dd>Explicit system boundaries and typed interfaces.</dd><dd>Node.js, TypeScript, Python, FastAPI, REST, GraphQL</dd></div></dl>",
      "css": ".ds-tools>div{display:grid;gap:1rem;border-top:1px solid var(--color-line);padding:1.75rem 0}.ds-tools dt{font:500 var(--text-h4)/1.3 var(--font-display);color:var(--color-fg)}.ds-tools dd{font:1.0625rem/1.6 var(--font-sans);color:var(--color-muted)}.ds-tools dd:last-child{font-size:.9375rem;color:var(--color-subtle)}@media(min-width:64rem){.ds-tools>div{grid-template-columns:3fr 5fr 4fr;gap:2rem}}"
    },
    {
      "name": "Section Heading",
      "kind": "custom",
      "description": "A clear heading and optional explanation, without a duplicate caption.",
      "html": "<div class=\"ds-section\"><h2>Tools we work with</h2><p>The stack depends on your system, budget and team.</p></div>",
      "css": ".ds-section h2{max-width:24ch;margin:0;color:var(--color-fg);font:600 var(--text-h2)/1.18 var(--font-display);letter-spacing:-.015em;text-wrap:balance}.ds-section p{max-width:62ch;margin-top:1.25rem;color:var(--color-muted);font:var(--text-lead)/1.6 var(--font-sans)}"
    }
  ],
  "narrative": {
    "northStar": "The Quorlyn Engineering Document",
    "overview": "Quorlyn uses a soft off-white public ground, dark ink, one consistent IBM Plex Sans interface family. Its source-derived Q/T monogram supplies the dimensional visual and the original cyan-to-magenta colors. Open rows and fine dividers organize the engineering content. Only the homepage hero runs a live scene; secondary pages and closing calls to action focus on their content. The staff area retains its dark palette.",
    "keyCharacteristics": [
      "Soft off-white public pages, dark ink and solid primary actions.",
      "IBM Plex Sans throughout the interface; original logo lettering and actual code/reference values retain their own faces.",
      "Open service, technology, principle and work rows with fine dividers.",
      "One continuously moving, pausable source-derived 3D logo in the homepage hero.",
      "Static readable content, visible keyboard focus and image fallbacks."
    ],
    "rules": [
      {
        "name": "Source authority",
        "body": "Preserve the official logo silhouette, fragments and sampled colors. Company facts and capabilities come from the repository; missing proof stays unpublished.",
        "section": "colors"
      },
      {
        "name": "Accent boundary",
        "body": "Gradients belong to the original monogram and TECHNOLOGY subtitle. Headings use solid ink; actions and focus use solid blue.",
        "section": "colors"
      },
      {
        "name": "One interface family",
        "body": "IBM Plex Sans carries headings, reading copy, navigation, controls and labels. Use 400 for reading, 500 for controls/short titles and 600 for h1/h2. Preserve Space Grotesk only for the QUORLYN wordmark and JetBrains Mono for actual codes/references and the official subtitle.",
        "section": "typography"
      },
      {
        "name": "Readable immediately",
        "body": "Reading sections are server-rendered static content. Reduced motion uses a still; user pause, off-screen state and tab visibility stop the live scene.",
        "section": "elevation"
      },
      {
        "name": "Structure before decoration",
        "body": "Use spacing and fine dividers. Do not add glass, glows, background grids, floating ornaments, repeated logo reliefs or uniform text cards.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Use the original brand artwork and verified content sources.",
      "Explain the problem, approach and deliverables in plain language.",
      "Keep existing routes, service anchors and enquiry mappings.",
      "Give controls visible focus and written error feedback.",
      "Regenerate the hero still from the actual mesh and retain provenance."
    ],
    "donts": [
      "Invent founder quotes, clients, team biographies, testimonials, metrics or delivery guarantees.",
      "Turn missing portfolio evidence into placeholder content.",
      "Add gradient headings, neon hover glows or blurred decorative cards.",
      "Animate reading sections or hide copy until it enters the viewport.",
      "Expose backend configuration instructions to public visitors."
    ]
  }
}
