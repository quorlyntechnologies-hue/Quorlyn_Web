# Copy to .env.local and fill in. Never commit .env.local.
#
# The site runs with none of these set: public pages render, the inquiry form
# validates and tells the visitor honestly that submissions are not yet stored,
# and /admin shows a setup notice. Each block below switches on one capability.
#
# NEXT_PUBLIC_* variables are inlined into the browser bundle. Everything else
# is server-only and must never be prefixed with NEXT_PUBLIC_.

# ── Database, auth and admin ────────────────────────────────────────── required
# Supabase → Project Settings → API. Free plan, no card.
# Note: free projects PAUSE after 7 days with no database request. The daily
# cron in vercel.json calls /api/health to keep it awake.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role. Bypasses every RLS policy — server-only, never in the browser,
# never in a NEXT_PUBLIC_ variable, and rotate it if it ever leaks.
SUPABASE_SERVICE_ROLE_KEY=

# ── Transactional email ─────────────────────────────────────────────── optional
# Without these, inquiries are still stored; nobody is emailed, and the server
# logs a warning naming the reference that went unnotified.
# Resend free plan: 3,000/month, capped at 100/day, one verified domain.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Must be a sender on a domain verified in Resend.
EMAIL_FROM="Quorlyn Technology <hello@quorlyn.com.np>"
# Where new-inquiry notifications land.
CONTACT_INBOX=

# ── Bot protection ──────────────────────────────────────────────────── optional
# Cloudflare Turnstile. Free: 1M siteverify calls/month. Unset, the widget does
# not render and the server treats the check as skipped.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Abuse correlation ───────────────────────────────────────────────── optional
# Any long random string: `openssl rand -hex 32`. Submitter IPs are stored as a
# salted SHA-256 so repeat abuse can be spotted without retaining an address.
# Unset, no IP data is stored at all.
IP_HASH_SALT=

# ── Cron ────────────────────────────────────────────────────────────── optional
# Set the same value in Vercel → Settings → Environment Variables so the
# scheduled keep-alive can identify itself.
CRON_SECRET=

# ── Public contact details ──────────────────────────────────────────── optional
# Rendered in the footer, contact page and Organization structured data.
# Left blank, the UI omits each one rather than showing a placeholder.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_STREET_ADDRESS=
